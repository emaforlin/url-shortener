# Copy to .env for local development: `cp .env.example .env`.
#
# .env is read only outside production. A production process must get these
# values from its orchestrator; a .env file present there aborts startup.

# Required. The public origin short links are built against.
PUBLIC_BASE_URL="http://localhost:8080"

# development (default) or production. Never set production here — it belongs in
# the deployment environment, and the loader rejects it when it comes from a file.
APP_ENV="development"

APP_PORT="8080"
LOG_LEVEL="info"

# APP_READ_TIMEOUT="5s"
# APP_WRITE_TIMEOUT="10s"
# APP_IDLE_TIMEOUT="120s"
# APP_REQUEST_TIMEOUT="8s"     # must stay below APP_WRITE_TIMEOUT
# APP_SHUTDOWN_TIMEOUT="15s"
# APP_MAX_BODY_BYTES="65536"
